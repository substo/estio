<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#0F172A"
            app:title="Estio SIM Relay"
            app:titleTextColor="#FFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E2E8F0"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/ivStatusIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@android:drawable/presence_offline"
                        app:tint="#64748B"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not Paired"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvServerUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan QR code from the CRM to connect"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pairing Controls -->
            <LinearLayout
                android:id="@+id/layoutPairing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Scan QR Code"
                    app:icon="@android:drawable/ic_menu_camera"
                    app:iconGravity="textStart"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#3B82F6"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OR ENTER MANUALLY"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxStrokeColor="#94A3B8"
                    app:hintTextColor="#64748B"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPairingCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="6-Digit Pairing Code"
                        android:textColor="#0F172A"
                        android:textColorHint="#94A3B8"
                        android:inputType="textCapCharacters"
                        android:maxLength="6"
                        android:textAlignment="center"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPair"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Submit Pairing Code"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0F172A"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Service Controls -->
            <LinearLayout
                android:id="@+id/layoutService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleService"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Start Relay Service"
                    app:cornerRadius="12dp"
                    android:backgroundTint="#10B981"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUnpair"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Unpair Device"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textColor="#EF4444"
                    app:rippleColor="#20EF4444" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
