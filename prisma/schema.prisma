// AI Agent Execution History - stores complete trace of each agent action

model AgentExecution {
  id String @id @default(cuid())

  // Ledger Routing
  locationId String  @default("legacy-migration-id")
  sourceType String  @default("conversation") // conversation | scraper | image_gen
  sourceId   String? // Dynamic ID to the polymorphic parent

  // Legacy fallback
  conversationId String?

  // Tracing & Observability
  traceId      String? @default(cuid())
  spanId       String? @default(cuid())
  parentSpanId String?
  skillName    String?
  intent       String?
  latencyMs    Int     @default(0)
  status       String  @default("pending")
  errorMessage String?

  // Task Info
  taskId     String? // ID from the plan
  taskTitle  String? // Title of the executed task
  taskStatus String? // Result status: done, failed

  // Thinking Trace
  thoughtSummary String? @db.Text
  thoughtSteps   Json? // Array of { step, description, conclusion }

  // Tool Execution Results
  toolCalls Json? // Array of { tool, arguments, result, error }

  // Output
  draftReply String? @db.Text

  // Token Usage Stats
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  model            String?
  cost             Float?

  createdAt DateTime @default(now())

  // Relations
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  feedback     AgentFeedback[]

  @@index([locationId, sourceType, createdAt])
  @@index([conversationId])
  @@index([createdAt])
  @@index([traceId])
}

model AiUsage {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  recordedAt DateTime @default(now())

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Polymorphic Resource Linking (e.g., "property", "viewing_session")
  resourceType String
  resourceId   String?
  
  // Feature Context
  featureArea String   // e.g., "property_image_enhancement"
  action      String   // e.g., "analyze", "precision_remove"
  
  // Provider & Model
  provider    String   // "google_gemini", "vertex_imagen"
  model       String   
  
  // Quantitative Metering
  inputTokens      Int?   @default(0)
  outputTokens     Int?   @default(0)
  totalTokens      Int?   @default(0)
  
  // Exact Cost Tracking for Billing
  estimatedCostUsd Float @default(0)
  
  // Metadata for auditing
  metadata Json?

  @@index([locationId, recordedAt(sort: Desc)])
  @@index([resourceType, resourceId, recordedAt(sort: Desc)])
  @@index([locationId, featureArea, recordedAt(sort: Desc)])
}

