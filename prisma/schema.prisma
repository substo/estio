model Conversation {
  id                String @id @default(cuid())
  locationId        String
  contactId         String
  ghlConversationId String? @unique

  status           String   @default("open")
  lastMessageBody  String?  @db.Text
  lastMessageAt    DateTime @default(now())
  lastMessageType  String? // TYPE_SMS, TYPE_EMAIL, TYPE_WHATSAPP
  unreadCount      Int      @default(0)
  suggestedActions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft Delete & Archive
  deletedAt  DateTime? // Soft delete timestamp (null = active, not null = in trash)
  archivedAt DateTime? // Archive timestamp (null = not archived, not null = archived)
  deletedBy  String? // User ID who deleted (for audit trail)

  // AI Agent Planner
  agentPlan Json? // Stores the structured task list [ { id, title, status, result } ]

  // Accumulated Usage Stats
  // Accumulated Usage Stats
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)
  totalTokens      Int   @default(0)
  totalCost        Float @default(0)

  // Phase 6: Semi-Auto & Event-Driven
  semiAuto              Boolean   @default(false) // AI auto-drafts on incoming events (never auto-sends)
  replyLanguageOverride String? // Optional per-conversation language override (BCP-47, null = auto)
  currentLanguage       String? // Detected/current customer language for this thread (BCP-47)
  currentLanguageSource String? // detected | manual | imported | inferred
  currentLanguageConfidence Float?
  currentLanguageUpdatedAt DateTime?
  contextSummary        String?   @db.Text // Compacted conversation context for long threads
  lastSummarizedAt      DateTime? // When context was last compacted

  // Relations
  location                   Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact                    Contact                   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages                   Message[]
  scheduledMessages          ScheduledMessage[]
  executions                 AgentExecution[]
  participants               ConversationParticipant[]
  insights                   Insight[]
  contactTasks               ContactTask[]
  userNotifications          UserNotification[]
  aiAutomationJobs           AiAutomationJob[]
  aiDecisions                AiDecision[]
  agentFeedback              AgentFeedback[]
  aiSuggestedResponses       AiSuggestedResponse[]
  requirementProposals       ContactRequirementProposal[]
  propertyMatchInteractions  ContactPropertyInteraction[]
  propertyMatchCandidates    PropertyMatchCandidate[]
  whatsappOutboundOutboxJobs WhatsAppOutboundOutbox[]
  whatsappCallAttempts       WhatsAppCallAttempt[]
  syncRecords                ConversationSync[]
  messageSyncRecords         MessageSync[]
  providerOutboxJobs         ProviderOutbox[]
  messageTranslationCaches   MessageTranslationCache[]
  dealLinks                  DealConversationLink[]
  smsRelayOutboxJobs         SmsRelayOutbox[]

  @@unique([locationId, contactId])
  @@index([locationId])
  @@index([contactId])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([locationId, deletedAt, archivedAt, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([locationId, deletedAt, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([locationId, updatedAt(sort: Asc), id(sort: Asc)])
}

model ContactTask {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationId     String
  contactId      String
  conversationId String?

  title           String
  description     String?   @db.Text
  status          String    @default("open") // open, completed, canceled
  priority        String    @default("medium") // low, medium, high
  dueAt           DateTime?
  completedAt     DateTime?
  assignedUserId  String?
  source          String    @default("manual") // manual, ai_selection, automation
  reminderMode    String    @default("default") // default, custom, off
  reminderOffsets Json? // array of offset minutes when reminderMode=custom

  createdByUserId String?
  updatedByUserId String?
  deletedAt       DateTime?
  syncVersion     Int       @default(1)
  metadata        Json?

  location      Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignedUser  User?         @relation("ContactTaskAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser User?         @relation("ContactTaskCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?         @relation("ContactTaskUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  syncRecords   ContactTaskSync[]
  outboxJobs    ContactTaskOutbox[]
  reminderJobs  TaskReminderJob[]
  notifications UserNotification[]

  @@index([locationId, contactId, status, dueAt])
  @@index([locationId, contactId, deletedAt, status, dueAt])
  @@index([locationId, deletedAt, status, dueAt, createdAt(sort: Desc), id])
  @@index([conversationId, status, dueAt])
  @@index([conversationId, deletedAt, status, dueAt])
  @@index([assignedUserId, status, dueAt])
  @@index([deletedAt])
}

