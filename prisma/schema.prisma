  syncRecords                  MessageSync[]
  smsRelayOutboxJobs           SmsRelayOutbox[]
  dispatchedScheduledMessages  ScheduledMessage[]           @relation("ScheduledMessageDispatchedMessage")

  // WhatsApp Integration
  wamId String? @unique // WhatsApp Message ID (for dedup)

  @@index([conversationId])
  @@index([createdAt])
  @@index([conversationId, updatedAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([emailThreadId])
}

