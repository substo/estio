  rawAttributes Json? // All key-value pairs from chars-column

  isExpired Boolean @default(false)
  status    String  @default("NEW") // NEW, REVIEWING, IMPORTED, REJECTED, SKIPPED

  // Link to imported Property (set when contact is accepted and property is imported)
  importedPropertyId String?

  // Link to the Prospect / Person
  prospectLeadId String?
  prospectLead   ProspectLead? @relation(fields: [prospectLeadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalId])
}

model MediaAsset {
  id                String           @id @default(cuid())
  cloudflareImageId String           @unique
  url               String
  status            MediaAssetStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
}

enum MediaAssetStatus {
  ACTIVE
  SOFT_DELETED
}

// ---------------------------------------------------------------------------
// SIM Relay — Android SMS Gateway
// ---------------------------------------------------------------------------

model SmsRelayDevice {
  id              String    @id @default(cuid())
  locationId      String
  label           String    // e.g. "Limassol Office Android"
  phoneNumber     String?   // E.164 of the SIM, e.g. "+35799123456"
  platform        String    @default("android") // android | ios (future)
  status          String    @default("offline") // online | offline | error
  pairTokenHash   String?   // SHA-256 of temporary pairing code
  pairExpiresAt   DateTime?
  pairAttemptCount Int      @default(0)
  paired          Boolean   @default(false)
  deviceApiTokenHash String? @db.Text // SHA-256 hash of the issued long-lived JWT
  devicePushToken String?   // FCM token for push notifications (optional)
  capabilities    String[]  @default(["sms_relay"])
  appVersion      String?
  tunnelPublicKey String?   @db.Text
  tunnelCredentialVersion Int @default(1)
  tunnelRevokedAt DateTime?
  tunnelChallengeHash String?
  tunnelChallengeExpiresAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  outboxJobs SmsRelayOutbox[]
  tunnelBinding DeviceTunnelBinding?

  @@index([locationId, status])
  @@index([locationId, paired])
  @@index([pairTokenHash])
}

model DeviceTunnelBinding {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationId String
  deviceId   String @unique
  sessionId  String @unique

  status             String   @default("offline") // offline | connecting | online | degraded | revoked
  networkType        String?  // wifi | cellular | ethernet | other | unknown
  gatewayNodeId      String?
  egressIpMasked     String?
  lastConnectedAt    DateTime?
  lastSeenAt         DateTime?
  lastTrafficAt      DateTime?
  lastVerifiedAt     DateTime?
  lastProofMessageHash String?
  lastProofBytesToDevice BigInt?
  lastProofBytesFromDevice BigInt?
  lastError          String?  @db.Text

  location Location                    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  device   SmsRelayDevice              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session  WhatsAppWebBridgeSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([locationId, status])
  @@index([status, lastSeenAt])
}

model SmsRelayOutbox {
  id             String   @id @default(cuid())
  locationId     String
  conversationId String
  messageId      String
  deviceId       String
  toNumber       String   // E.164 recipient number
  body           String   @db.Text

  // status: pending | processing | sent | failed | dead | cancelled
  status         String   @default("pending")
  scheduledAt    DateTime @default(now())
  lockedAt       DateTime?
  lockedBy       String?  // worker ID
  processedAt    DateTime?
  attemptCount   Int      @default(0)
  lastError      String?  @db.Text

  // Deduplication key: <locationId>:<messageId>
  idempotencyKey String   @unique

  location     Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  device       SmsRelayDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  message      Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([deviceId, status])
  @@index([locationId, status, scheduledAt])
  @@index([messageId])
}
