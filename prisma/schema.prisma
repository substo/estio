generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Location {
  id                            String                         @id @default(cuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  ghlAgencyId                   String?                        @unique
  ghlLocationId                 String?                        @unique
  ghlInstallId                  String?                        @unique
  ghlAccessToken                String?
  ghlRefreshToken               String?
  ghlTokenType                  String?
  ghlExpiresAt                  DateTime?
  ghlScopes                     String? // Space-separated list of granted OAuth scopes
  name                          String?
  domain                        String?
  timeZone                      String? // IANA timezone, e.g. "Europe/Nicosia"
  lastSsoValidation             DateTime?
  lastSsoUserId                 String?
  companies                     Company[]
  contacts                      Contact[]
  properties                    Property[]
  propertyMatchCampaigns        PropertyMatchCampaign[]
  propertyMatchCandidates       PropertyMatchCandidate[]
  projects                      Project[]
  siteConfig                    SiteConfig?
  swipeSessions                 SwipeSession[]
  users                         User[]                         @relation("LocationToUser")
  userRoles                     UserLocationRole[]
  contentPages                  ContentPage[]
  blogPosts                     BlogPost[]
  leadSources                   LeadSource[]
  dealContexts                  DealContext[]
  conversations                 Conversation[]
  contactTasks                  ContactTask[]
  contactTaskOutboxJobs         ContactTaskOutbox[]
  contactOutboxJobs             ContactOutbox[]
  aiAutomationSchedules         AiAutomationSchedule[]
  prospectLeads                 ProspectLead[]
  aiAutomationJobs              AiAutomationJob[]
  aiSkillPolicies               AiSkillPolicy[]
  aiDecisions                   AiDecision[]
  aiRuntimeJobs                 AiRuntimeJob[]
  locationAiPromptVersions      LocationAiPromptVersion[]
  locationKnowledgeEntries      LocationKnowledgeEntry[]
  agentFeedback                 AgentFeedback[]
  learningSessions              LearningSession[]
  learningProposals             LearningProposal[]
  contactClassificationRuns     ContactClassificationRun[]
  contactClassificationRunItems ContactClassificationRunItem[]
  aiSuggestedResponses          AiSuggestedResponse[]
  contactRequirementProposals   ContactRequirementProposal[]
  legacyCrmLeadEmailProcessings LegacyCrmLeadEmailProcessing[]
  userNotifications             UserNotification[]
  taskReminderJobs              TaskReminderJob[]
  scheduledMessages             ScheduledMessage[]
  scrapingConnections           ScrapingConnection[]
  scrapingTasks                 ScrapingTask[]
  deepScrapeRuns                DeepScrapeRun[]
  deepScrapeRunStages           DeepScrapeRunStage[]
  agentExecutions               AgentExecution[]
  whatsappOutboundOutboxJobs    WhatsAppOutboundOutbox[]
  whatsappChannels              WhatsAppChannel[]
  whatsappWebBridgeSessions     WhatsAppWebBridgeSession[]
  whatsappTemplates             WhatsAppTemplate[]
  whatsappIdentityMaps          WhatsAppIdentityMap[]
  whatsappCallAttempts          WhatsAppCallAttempt[]
  whatsappCallingConfig         WhatsAppCallingConfig?
  conversationSyncRecords       ConversationSync[]
  messageSyncRecords            MessageSync[]
  providerOutboxJobs            ProviderOutbox[]
  viewingSessions               ViewingSession[]
  viewingSessionEvents          ViewingSessionEvent[]
  viewingSessionUsages          ViewingSessionUsage[]
  aiUsages                      AiUsage[]
  messageTranslationCaches      MessageTranslationCache[]
  analyticsVisitors             AnalyticsVisitor[]
  analyticsSessions             AnalyticsSession[]
  analyticsEvents               AnalyticsEvent[]
  analyticsDailyRollups         AnalyticsDailyRollup[]
  publicSiteDomains             PublicSiteDomain[]
  publicSiteDomainJobs          PublicSiteDomainProvisioningJob[]
  contactPropertyMatchProfiles ContactPropertyMatchProfile[]
  contactPropertyInteractions  ContactPropertyInteraction[]

  // SIM Relay (Android SMS Gateway)
  smsRelayEnabled Boolean @default(false)

  // WhatsApp Integration (Native)
  whatsappBusinessAccountId String?
  whatsappPhoneNumberId     String?
  whatsappAccessToken       String? @db.Text // Long-lived system user token
  whatsappWebhookSecret     String?
  whatsappProviderMode      String  @default("web_bridge") // cloud_primary | twilio_fallback | web_bridge

  // Twilio Integration
  twilioAccountSid   String?
  twilioAuthToken    String? // Encrypted
  twilioWhatsAppFrom String?

  whatsappImportSessions WhatsAppImportSession[]

  // SIM Relay
  smsRelayDevices    SmsRelayDevice[]
  smsRelayOutboxJobs SmsRelayOutbox[]
  deviceTunnelBindings DeviceTunnelBinding[]

  // CRM Integration (Location-wide settings)
  crmUrl            String?
  crmEditUrlPattern String?
  crmLeadUrlPattern String?
  crmSchema         Json?
  crmLeadSchema     Json?
  publicListingUrlMode       String  @default("ESTIO") // ESTIO | LEGACY_EXTERNAL
  legacyPublicListingUrlPattern String?

  // Legacy CRM Lead Email Notification (Old CRM -> Outlook -> Estio)
  legacyCrmLeadEmailEnabled               Boolean  @default(false)
  legacyCrmLeadEmailSenders               String[] @default([])
  legacyCrmLeadEmailSenderDomains         String[] @default([])
  legacyCrmLeadEmailSubjectPatterns       String[] @default([])
  legacyCrmLeadEmailPinConversation       Boolean  @default(true)
  legacyCrmLeadEmailAutoProcess           Boolean  @default(false)
  legacyCrmLeadEmailAutoDraftFirstContact Boolean  @default(false)
}

model LeadSource {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  name     String
  isActive Boolean @default(true)

  @@unique([locationId, name])
  @@index([locationId])
}

model ContentPage {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  locationId String

  title           String
  slug            String // e.g. "about-us", "sellers-guide"
  content         String? @db.Text // Storing raw HTML for simplicity
  blocks          Json? // Structured content blocks (Hero, Features, Form, etc.)
  headerStyle     String? // "transparent" | "solid"
  heroImage       String? // Cloudflare Image ID or URL for transparent header hero
  metaTitle       String? // SEO title (overrides Page Title)
  metaDescription String? // SEO description for SERP snippets

  // AI Tracking
  aiImportSourceUrl String?
  aiModelUsed       String?

  published Boolean @default(false)

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, slug]) // Slugs must be unique per tenant
}

model BlogPost {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  locationId String

  title       String
  slug        String // e.g. "market-update-q1"
  excerpt     String?
  content     String?   @db.Text
  coverImage  String? // Cloudflare Image ID or URL
  published   Boolean   @default(false)
  publishedAt DateTime?

  authorName String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, slug])
}

model User {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  email         String   @unique
  name          String? // Legacy - kept for backward compatibility
  firstName     String?
  lastName      String?
  phone         String?
  clerkId       String?  @unique
  ghlUserId     String?
  ghlCalendarId String?
  timeZone      String? // IANA timezone, e.g. "Europe/Nicosia"

  // CRM Credentials (User-specific login)
  crmUsername String?
  crmPassword String?

  locations     Location[]         @relation("LocationToUser")
  locationRoles UserLocationRole[]

  createdProperties            Property[]                  @relation("PropertyCreator")
  updatedProperties            Property[]                  @relation("PropertyUpdater")
  viewings                     Viewing[]
  viewingSessions              ViewingSession[]
  assignedViewingSessions      ViewingSession[]            @relation("ViewingSessionAssignedBy")
  contactHistory               ContactHistory[]
  assignedContactTasks         ContactTask[]               @relation("ContactTaskAssignedUser")
  createdContactTasks          ContactTask[]               @relation("ContactTaskCreatedByUser")
  updatedContactTasks          ContactTask[]               @relation("ContactTaskUpdatedByUser")
  webPushSubscriptions         WebPushSubscription[]
  userNotifications            UserNotification[]
  taskReminderJobs             TaskReminderJob[]
  taskReminderPreference       UserTaskReminderPreference?
  settingsAuditLogs            SettingsAuditLog[]          @relation("SettingsAuditActor")
  acceptedAiSuggestedResponses AiSuggestedResponse[]       @relation("AiSuggestedResponseAcceptedBy")
  rejectedAiSuggestedResponses AiSuggestedResponse[]       @relation("AiSuggestedResponseRejectedBy")
  createdScheduledMessages     ScheduledMessage[]          @relation("ScheduledMessageCreatedBy")
  approvedScheduledMessages    ScheduledMessage[]          @relation("ScheduledMessageApprovedBy")
  approvedContactRequirementProposals ContactRequirementProposal[] @relation("ContactRequirementProposalApprovedBy")
  rejectedContactRequirementProposals ContactRequirementProposal[] @relation("ContactRequirementProposalRejectedBy")
  createdPropertyMatchCampaigns PropertyMatchCampaign[] @relation("PropertyMatchCampaignCreatedBy")
  reviewedPropertyMatchCandidates PropertyMatchCandidate[] @relation("PropertyMatchCandidateReviewedBy")
  updatedPropertyImagePromptProfiles PropertyImagePromptProfile[] @relation("PropertyImagePromptProfileUpdater")
  aiUsages                     AiUsage[]
  analyticsVisitors            AnalyticsVisitor[]
  analyticsEvents              AnalyticsEvent[]

  // Google Contact Sync Credentials
  googleAccessToken             String?         @db.Text
  googleRefreshToken            String?         @db.Text
  googleSyncToken               String? // To track the last sync point
  googleSyncEnabled             Boolean         @default(false)
  googleSyncDirection           String? // "ESTIO_TO_GOOGLE" | "GOOGLE_TO_ESTIO" - Source of Truth setting
  googleAutoSyncEnabled         Boolean         @default(false) // Master toggle for opt-in Google contact automation
  googleAutoSyncLeadCapture     Boolean         @default(false) // New Conversation + Paste Lead
  googleAutoSyncContactForm     Boolean         @default(false) // Contacts create/update form actions
  googleAutoSyncWhatsAppInbound Boolean         @default(false) // WhatsApp webhook-driven contact creation
  googleAutoSyncMode            String          @default("LINK_ONLY") // "LINK_ONLY" | "LINK_OR_CREATE"
  googleAutoSyncPushUpdates     Boolean         @default(false) // Push updates for already-linked contacts
  googleTasklistId              String? // Preferred Google Tasks list id for task sync-out
  googleTasklistTitle           String? // Cached display name for preferred Google Tasks list
  googleCalendarId              String? // Preferred Google Calendar id for viewing sync-out
  googleCalendarTitle           String? // Cached display name for preferred Google Calendar
  gmailSyncState                GmailSyncState?
  gmailSyncOutboxJobs           GmailSyncOutbox[]

  // Outlook / Microsoft Sync Credentials (OAuth method)
  outlookAccessToken        String?           @db.Text
  outlookRefreshToken       String?           @db.Text
  outlookSyncEnabled        Boolean           @default(false)
  outlookSubscriptionId     String? // Webhook Subscription ID
  outlookSubscriptionExpiry DateTime? // Webhook Expiry
  outlookSyncState          OutlookSyncState?

  // Outlook Puppeteer Auth (Alternative when OAuth blocked)
  outlookAuthMethod        String? // 'oauth' | 'puppeteer'
  outlookEmail             String? // User's Outlook email
  outlookPasswordEncrypted String?   @db.Text // AES-256 encrypted password
  outlookSessionCookies    String?   @db.Text // Encrypted JSON of session cookies
  outlookSessionExpiry     DateTime? // When session cookies expire
}

model Property {
  id                String            @id @default(cuid())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  locationId        String
  title             String
  slug              String            @unique
  description       String?
  reference         String?           @unique
  status            PropertyStatus    @default(ACTIVE)
  type              String?
  price             Int?
  currency          String?
  bedrooms          Int?
  bathrooms         Int?
  areaSqm           Int?
  addressLine1      String?
  addressLine2      String?
  city              String?
  country           String?
  postalCode        String?
  latitude          Float?
  longitude         Float?
  featured          Boolean           @default(false)
  category          String?
  features          String[]          @default([])
  condition         String?
  source            String            @default("IDX")
  buildYear         Int?
  plotAreaSqm       Int?
  goal              ListingGoal       @default(SALE)
  publicationStatus PublicationStatus @default(PUBLISHED)
  propertyArea      String?
  propertyLocation  String?
  communalFees      Int?
  metaDescription   String?
  metaKeywords      String?
  metaTitle         String?
  rentalPeriod      String?
  metadata          Json? // For dynamic schema expansion

  // Vector embedding (added via raw migration in scripts/embed-properties.ts)
  // embedding vector(3072)

  // Extended Area Details
  coveredAreaSqm      Int? // "Internal Covered"
  coveredVerandaSqm   Int?
  uncoveredVerandaSqm Int?
  basementSqm         Int?
  sortOrder           Int      @default(0)
  floor               Int?
  agentRef            String?
  agentUrl            String?
  externalPublicUrl   String?
  externalPublicUrlSource String?
  legacyCrmPropertyId String?
  estimatedValue      Int?
  internalNotes       String?
  keyHolder           String?
  landSurveyValue     Int?
  lawyer              String?
  loanDetails         String?
  lowestOffer         Int?
  managementCompany   String?
  occupancyStatus     String?
  projectName         String?
  projectId           String?
  project             Project? @relation(fields: [projectId], references: [id])
  purchasePrice       Int?
  unitNumber          String?
  viewingContact      String?
  viewingDirections   String?
  viewingNotes        String?

  agencyAgreement String?
  commission      String?
  agreementDate   DateTime?
  agreementNotes  String?
  deposit         String?
  depositValue    Int?

  billsTransferable         Boolean? @default(false)
  priceIncludesCommunalFees Boolean? @default(false)
  keyBoxCode                String?
  officeKeyNumber           String?

  ghlPropertyObjectId String?               @unique
  companyRoles        CompanyPropertyRole[]

  contactRoles           ContactPropertyRole[]
  propertyMatchCampaigns PropertyMatchCampaign[]
  location               Location              @relation(fields: [locationId], references: [id])
  media                  PropertyMedia[]
  translations           PropertyTranslation[]
  printDrafts            PropertyPrintDraft[]
  imagePromptProfiles    PropertyImagePromptProfile[]
  swipes                 PropertySwipe[]
  viewings               Viewing[]
  primaryViewingSessions ViewingSession[]      @relation("ViewingSessionPrimaryProperty")
  activeViewingSessions  ViewingSession[]      @relation("ViewingSessionCurrentProperty")
  analyticsEvents        AnalyticsEvent[]
  propertyMatchInteractions ContactPropertyInteraction[]

  createdById String?
  creator     User?   @relation("PropertyCreator", fields: [createdById], references: [id])
  updatedById String?
  updater     User?   @relation("PropertyUpdater", fields: [updatedById], references: [id])

  // Original CRM Import Details
  originalCreatorName  String?
  originalCreatorEmail String?
  originalCreatedAt    DateTime?
  originalUpdatedAt    DateTime?

  // Scraping Provenance
  scrapedListingId String? // Back-reference to original ScrapedListing if imported from scraping

  // Feed Integration
  feedId          String?
  feed            PropertyFeed? @relation(fields: [feedId], references: [id])
  feedReferenceId String? // External ID from the feed
  feedHash        String? // Hash to detect changes

  @@unique([feedId, feedReferenceId])
}

model PropertyPrintDraft {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  propertyId         String
  name               String
  templateId         String
  paperSize          String
  orientation        String
  languages          String[] @default([])
  selectedMediaIds   String[] @default([])
  isDefault          Boolean  @default(false)
  designSettings     Json?
  promptSettings     Json?
  generatedContent   Json?
  generationMetadata Json?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, updatedAt(sort: Desc)])
  @@index([propertyId, isDefault])
}

model PropertyTranslation {
  id              String   @id @default(cuid())
  propertyId      String
  languageCode    String
  title           String?
  description     String?  @db.Text
  metaTitle       String?
  metaDescription String?  @db.Text
  isAiGenerated   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  @@unique([propertyId, languageCode])
  @@index([propertyId])
}

model PropertyMedia {
  id                String    @id @default(cuid())
  createdAt         DateTime  @default(now())
  propertyId        String
  url               String
  kind              MediaKind @default(IMAGE)
  sortOrder         Int       @default(0)
  title             String?
  cloudflareImageId String?
  metadata          Json?
  property          Property  @relation(fields: [propertyId], references: [id])
}

model PropertyImagePromptProfile {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  propertyId    String
  roomTypeKey   String
  roomTypeLabel String
  promptContext String   @db.Text
  analysisData  Json?
  updatedById   String?

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("PropertyImagePromptProfileUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([propertyId, roomTypeKey])
  @@index([propertyId, updatedAt(sort: Desc)])
}

model SiteConfig {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  locationId String   @unique

  // New Fields
  domain                     String? @unique
  theme                      Json?
  navLinks                   Json?
  footerLinks                Json? // Footer Menu (New)
  socialLinks                Json? // Social Media Links (New)
  legalLinks                 Json? // Legal/Bottom Menu (New)
  footerDisclaimer           String? // Custom license/disclaimer text (New)
  footerBio                  String? // Custom biography/description text under logo (New)
  heroContent                Json?
  contactInfo                Json? // Address, Phone, Email
  googleAiApiKey             String? // Google Gemini AI API Key
  googleAiModel              String? @default("gemini-1.5-pro") // Default / Legacy
  googleAiModelExtraction    String? @default("gemini-1.5-flash") // Stage 1: Fast Scraper
  googleAiModelDesign        String? @default("gemini-1.5-pro") // Stage 2: High-End Designer
  googleAiModelTranscription String? @default("gemini-2.5-flash") // Phase 1: Audio transcription default
  googleAiModelTranslation   String? @default("gemini-flash-lite-latest") // Conversation translation default
  brandVoice                 String? // Custom instructions for AI Brand Voice
  homeSections               Json? // Configuration for Home Page Sections (order, visibility)
  favoritesConfig            Json? // { title, emptyTitle, emptyBody, headerStyle, heroImage }
  searchConfig               Json? // { metaTitle, metaDescription, emptyTitle, emptyBody }
  submissionsConfig          Json? // { title, emptyTitle, emptyBody, headerStyle, heroImage }

  outreachConfig Json? // AI Outreach Assistant Configuration (Prompts, Enabled status)

  publicListingEnabled              Boolean @default(true) // Feature Flag for "List Your Property"
  whatsappTranscriptOnDemandEnabled Boolean @default(false) // Phase 2A: Manual transcript/backfill controls
  whatsappTranscriptRetentionDays   Int     @default(90) // Phase 2C: retention policy (30/90/365)
  whatsappTranscriptVisibility      String  @default("team") // Phase 2C: transcript visibility (team|admin_only)
  viewingSessionRetentionDays       Int     @default(90) // Viewing transcript retention policy (30/90/365)
  viewingSessionTranscriptVisibility String @default("team") // Viewing transcript visibility (team|admin_only)
  viewingSessionAiDisclosureRequired Boolean @default(true) // Require client AI disclosure acknowledgment
  viewingSessionAiDisclosureVersion String  @default("v1") // Disclosure copy/version identifier captured into session consent audit
  viewingSessionRawAudioStorageEnabled Boolean @default(false) // V1 default keeps raw audio persistence disabled
  viewingSessionTranslationModel    String?
  viewingSessionInsightsModel       String?
  viewingSessionSummaryModel        String?

  // Existing Fields
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  minPrice       Int?
  maxPrice       Int?
  defaultCity    String?
  defaultRegion  String?
  allowedTypes   String?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("SearchConfig")
}

enum PublicSiteDomainRole {
  CANONICAL
  REDIRECT
}

enum PublicSiteDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  RELEASED
}

enum PublicSiteDomainJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model PublicSiteDomain {
  id                String                 @id @default(cuid())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  locationId        String
  hostname          String                 @unique
  role              PublicSiteDomainRole   @default(CANONICAL)
  status            PublicSiteDomainStatus @default(PENDING)
  verificationToken String                 @unique
  verifiedAt        DateTime?
  activatedAt       DateTime?
  releasedAt        DateTime?
  lastDnsCheckAt    DateTime?
  lastHealthCheckAt DateTime?
  provisioningError String?                @db.Text
  createdByUserId   String?
  releasedByUserId  String?

  location Location                          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  jobs     PublicSiteDomainProvisioningJob[]

  @@index([locationId, status])
  @@index([locationId, role, status])
  @@map("public_site_domains")
}

model PublicSiteDomainProvisioningJob {
  id             String                    @id @default(cuid())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  locationId     String
  domainId       String
  operation      String
  status         PublicSiteDomainJobStatus @default(PENDING)
  idempotencyKey String                    @unique
  attemptCount   Int                       @default(0)
  scheduledAt    DateTime                  @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  lastError      String?                   @db.Text

  location Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  domain   PublicSiteDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([domainId, status])
  @@index([locationId, status])
  @@map("public_site_domain_provisioning_jobs")
}

model Contact {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  locationId String

  name          String?
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  message       String?
  preferredLang String? // "en", "el", etc.
  notes         String? // General notes ("contact_other")
  languageProfiles ContactLanguage[]

  // Enhanced Demographics
  dateOfBirth DateTime?
  tags        String[]  @default([])

  // Address Fields
  address1   String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  clerkUserId         String?  @unique // Links this Contact to an authenticated Clerk User (Public Login)
  ghlContactId        String?  @unique
  ghlCompanyId        String?
  ghlPropertyObjectId String?
  ghlOppId            String?
  interestedCount     Int      @default(0)
  maybeCount          Int      @default(0)
  notCount            Int      @default(0)
  heatScore           Int      @default(0)
  legacyCrmOwnerId    String?
  legacyCrmOwnerLabel String?
  payload             Json?
  status              String
  contactType         String   @default("Lead") // Lead, Agent, Partner, Owner, Associate, Maintenance, Contact, Tenant
  error               String?
  location            Location @relation(fields: [locationId], references: [id])

  companyRoles  ContactCompanyRole[]
  propertyRoles ContactPropertyRole[]
  swipes        PropertySwipe[]
  swipeSessions SwipeSession[]

  // Lead Details
  leadGoal            String? // "To Buy", "To Rent", "To List", "Other"
  leadPriority        String    @default("Medium") // "Low", "Medium", "High"
  leadStage           String    @default("Unassigned")
  leadSource          String?
  leadNextAction      String?
  leadFollowUpDate    DateTime?
  leadAssignedToAgent String?

  // Requirements
  requirementStatus            String   @default("For Sale") // "For Sale", "For Rent"
  requirementDistrict          String   @default("Any District")
  requirementBedrooms          String   @default("Any Bedrooms")
  requirementMinPrice          String   @default("Any")
  requirementMaxPrice          String   @default("Any")
  requirementCondition         String   @default("Any Condition")
  requirementPropertyTypes     String[] @default([])
  requirementPropertyLocations String[] @default([])
  requirementOtherDetails      String?
  requirementSummary           String?  @db.Text
  requirementsLastAssessedAt   DateTime?
  requirementsAssessmentDueAt  DateTime?
  requirementsLastError        String?  @db.Text

  // Property Matching
  matchingPropertiesToMatch      String    @default("Updated and New")
  matchingEmailMatchedProperties String    @default("Yes - Automatic")
  matchingNotificationFrequency  String    @default("Weekly")
  matchingLastMatchDate          DateTime?

  // Properties Tab
  propertiesInterested String[]         @default([])
  propertiesInspected  String[]         @default([])
  propertiesEmailed    String[]         @default([])
  propertiesMatched    String[]         @default([])
  // Property Won Details
  propertyWonValue     Int?
  wonCommission        Int?
  propertyWonReference String?
  propertyWonDate      DateTime?
  viewings             Viewing[]
  viewingSessions      ViewingSession[]
  history              ContactHistory[]
  conversations        Conversation[]

  // Google Sync
  googleContactId        String?
  lastGoogleSync         DateTime?
  googleContactUpdatedAt DateTime? // Timestamp from Google's metadata for "last write wins"

  // Outlook / Microsoft Sync
  outlookContactId        String?
  lastOutlookSync         DateTime?
  outlookContactUpdatedAt DateTime?

  conversationParticipations ConversationParticipant[]

  // WhatsApp Metadata
  lid                              String?   // WhatsApp Lightweight ID (for mapping)
  whatsappLastInboundAt           DateTime?
  whatsappCustomerServiceExpiresAt DateTime?

  // AI Lead Scoring (Phase 2)
  leadScore          Int?    @default(0)
  qualificationStage String? @default("unqualified")
  buyerProfile       Json?

  // Contact Profile Verification
  profileVerifiedAt             DateTime?
  profileVerificationStatus     String?
  profileVerificationSource     String?
  profileVerificationConfidence Float?
  profileVerificationSummary    String?   @db.Text
  profileVerificationDueAt      DateTime?
  profileVerificationLastAttemptAt DateTime?
  profileVerificationLastError  String?   @db.Text
  profileVerificationAttemptCount Int      @default(0)

  insights                   Insight[]
  tasks                      ContactTask[]
  userNotifications          UserNotification[]
  aiAutomationJobs           AiAutomationJob[]
